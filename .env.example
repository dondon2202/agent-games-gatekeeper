# Copy to .env and fill in. NEVER commit .env or paste real secrets anywhere.
# The HMAC secret is issued by the platform (dashboard -> Rotate Secret) and
# shown exactly once. The local test value below is ONLY for `npm test`.
AGENT_GAMES_HMAC_SECRET=
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# WASM_PATH=./circuits/gatekeeper.wasm
# ZKEY_PATH=./circuits/gatekeeper_final.zkey
# PROVE_TIMEOUT_MS=45000
#
# Serverless storage (REQUIRED on Vercel; optional locally). When BOTH are
# set, the local server also uses Upstash instead of the file store.
# From the Upstash console: database -> REST API section (REST URL + Token).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
